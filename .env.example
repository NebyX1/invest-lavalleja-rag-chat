# Copiá este archivo como .env y completá tus valores. Nunca subas el .env real.

# Clave de API de Ollama Cloud (https://ollama.com/settings/keys)
OLLAMA_API_KEY=tu_clave_de_ollama_aqui

# Modelo en Ollama Cloud (el sufijo ":cloud" se ignora al llamar a ollama.com)
OLLAMA_MODEL=deepseek-v4.1-flash:cloud

# Opcionales
# OLLAMA_HOST=https://ollama.com
# TOP_K=8
# Almacén vectorial: lancedb (por defecto, en disco) o numpy (todo en memoria)
# VECTOR_BACKEND=lancedb
