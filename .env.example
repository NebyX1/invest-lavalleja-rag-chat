# Copiá este archivo como .env y completá tus valores. Nunca subas el .env real.

# Clave de API de Ollama Cloud (https://ollama.com/settings/keys)
OLLAMA_API_KEY=tu_clave_de_ollama_aqui

# Modelo en Ollama Cloud (el sufijo ":cloud" se ignora al llamar a ollama.com)
OLLAMA_MODEL=deepseek-v4.1-flash:cloud

# Opcionales
# OLLAMA_HOST=https://ollama.com
# TOP_K=8
# Almacén vectorial: lancedb (por defecto, en disco) o numpy (todo en memoria)
# VECTOR_BACKEND=lancedb

# Panel: ADMIN_EMAIL y ADMIN_PASSWORD crean la primera cuenta solo si no existen usuarios.
# Quitá ADMIN_PASSWORD del entorno después de crear la cuenta. No resetea cuentas existentes.
# ADMIN_EMAIL=administrador@tu-dominio.uy
# ADMIN_PASSWORD=una_contrasena_larga_y_unica
# Obligatorio en Docker/Coolify: generá uno con secrets.token_urlsafe(48).
# ADMIN_SECRET_KEY=
# ADMIN_COOKIE_SECURE=true
# ADMIN_ALLOWED_ORIGINS=https://gianna.tu-dominio.uy
# ADMIN_SESSION_HOURS=8

# Correo: también puede ir en backend/.env en desarrollo. En Coolify va en Variables.
# MAIL_SERVER=smtp.tu-dominio.uy
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USE_SSL=false
# MAIL_USERNAME=usuario_smtp
# MAIL_PASSWORD=clave_smtp
# MAIL_DEFAULT_SENDER=Gianna <noreply@tu-dominio.uy>
# No actives TLS y SSL simultáneamente. Para SSL: puerto 465, TLS=false, SSL=true.

# En Coolify, donde el puerto solo es accesible por su proxy:
# PROXY_TRUSTED_IPS=*
