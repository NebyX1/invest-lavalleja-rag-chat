OLLAMA_API_KEY=tu_clave_de_ollama_aqui
OLLAMA_MODEL=deepseek-v4.1-flash:cloud
OLLAMA_HOST=https://ollama.com
VECTOR_BACKEND=lancedb
TOP_K=8

# Obligatorio en producción: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SECRET_KEY=
ADMIN_COOKIE_SECURE=true
ADMIN_COOKIE_SAMESITE=strict
# URL del frontend, no la del backend. Sin barra final. Múltiples: separar por comas.
CORS_ORIGINS=https://invest.tu-dominio.uy
ADMIN_ALLOWED_ORIGINS=https://invest.tu-dominio.uy
ADMIN_SESSION_HOURS=8
# Primera cuenta, sólo si no hay usuarios. Retirar ADMIN_PASSWORD después.
ADMIN_EMAIL=
ADMIN_PASSWORD=

MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# IP o CIDR exacto del proxy de Coolify/Nginx que conecta al backend.
PROXY_TRUSTED_IPS=127.0.0.1
# Volumen Docker /data: administración, documentos, modelos y contadores. Sin conversaciones.
# ADMIN_DATA_DIR=/data/admin
# MODEL_CACHE=/data/models
# INDEX_DIR=/data/legacy-index
