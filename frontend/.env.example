# Variables públicas de compilación. Nunca colocar claves del modelo ni SMTP aquí.
# En blanco: Nginx conecta /api al backend (recomendado).
# Para CORS directo: https://api.invest.tu-dominio.uy (sin /api ni barra final).
VITE_API_URL=
PUBLIC_SITE_URL=https://invest.tu-dominio.uy
PUBLIC_INDEXING=true

# Variables de ejecución del contenedor Nginx.
BACKEND_URL=http://backend:8010
# CIDR real de la red del proxy Coolify; no confiar en cualquier IP.
TRUSTED_PROXY_CIDR=127.0.0.1/32
